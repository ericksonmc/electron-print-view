# URL que abre el modo "full" (el contenedor/webview). Default: https://cdapuestas.com
APP_URL=https://cdapuestas.com

# Host/puerto del servidor WebSocket de impresión.
WS_HOST=127.0.0.1
WS_PORT=1315

# auto (default) | usb | spooler | null
# - auto: spooler en Windows, USB/libusb en Linux, con fallback al otro.
# - usb: fuerza USB/libusb (requiere Zadig/WinUSB en Windows).
# - spooler: fuerza el spooler del sistema (CUPS/winspool), respeta PRINTER_NAME.
# - null: no imprime, solo vuelca los bytes ESC/POS en hexadecimal (pruebas).
PRINTER_TRANSPORT=auto

# Nombre de la impresora en el spooler del sistema. Vacío = impresora por defecto.
PRINTER_NAME=
